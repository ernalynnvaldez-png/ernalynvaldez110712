    public static void main(String[] args) {   // Main method

        System.out.println("Go placidly amid the noise and haste,");
        // Output statement

        System.out.println("and remember what peace there may be in silence.");
        // Output statement

        System.out.println("As far as possible, without surrender,");
        // Output statement

        System.out.println("be on good terms with all persons. Speak your truth quietly and");
        // Output statement

        System.out.println("clearly; and listen to others, even to the dull and the ignorant,");
        // Output statement

        System.out.println("they too have their story.");
        // Output statement

        System.out.println("Avoid loud and aggressive person.");
        // Output statement

    }                                      // End of main method
