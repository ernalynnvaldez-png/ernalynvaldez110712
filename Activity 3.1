public class DemoVariables10{

    public static void main(String[] args) {

        // Declare Boolean variables using relational operators
        boolean isProgrammingFun = (10 > 5);
        boolean isProgrammingHard = (10 <= 5);

        // Display the values
        System.out.println("The value of isProgrammingFun is "
                + isProgrammingFun);

        System.out.println("The value of isProgrammingHard is "
                + isProgrammingHard);

    }
}
